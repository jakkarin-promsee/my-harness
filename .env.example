# Copy this file to `.env` and fill in real values. `.env` is gitignored.

# Gemini API key — https://aistudio.google.com/apikey
# Used by labs/02_provider_swap.py (and later stages as the paid fallback).
# Remember: ~$19 credit total. Debug loops on Ollama (free), validate on Gemini.
GEMINI_API_KEY=paste-your-key-here

# Which local model the harness and labs use (must be pulled in Ollama first).
# qwen3:4b-instruct = the non-thinking 2507 refresh — the Stage-2 local workhorse.
OLLAMA_MODEL=qwen3:4b-instruct

# Ollama's context window (tokens). Also set machine-wide via
# `setx OLLAMA_CONTEXT_LENGTH 8192` + Ollama restart so the SERVER honors it;
# this copy lets the harness display the right budget. 8192 is the sensible
# ceiling for a 4 GB card.
OLLAMA_CONTEXT_LENGTH=8192
